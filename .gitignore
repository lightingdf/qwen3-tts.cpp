# ios-bench: project.yml is the committed source of truth (like
# CMakeLists.txt); the .xcodeproj and the Info.plists xcodegen writes from
# project.yml's `info.properties` are regenerated by `xcodegen generate`
# and shouldn't be committed alongside it.
ios-bench/*.xcodeproj/
ios-bench/Generated-Info-*.plist

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Sisyphus state
.sisyphus/boulder.json
.sisyphus/notepads/

